{
  "name": "@avanpost/server-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/cli/doctor.ts src/cli/migrate.ts src/cli/dev.ts src/cli/stop.ts src/cli/create-manual-database.ts src/cli/prepare-manual-world.ts src/cli/reset-isolated-world.ts src/cli/create-g6-acceptance-database.ts src/cli/create-g7-acceptance-database.ts src/cli/prepare-g7-acceptance.ts src/cli/resume-g7-acceptance.ts src/cli/create-g72-acceptance-database.ts src/cli/prepare-g72-acceptance.ts src/cli/resume-g72-acceptance.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli/dev.ts",
    "stop": "tsx src/cli/stop.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "reset:test-world": "tsx src/cli/reset-isolated-world.ts",
    "create:g6-acceptance-database": "tsx src/cli/create-g6-acceptance-database.ts",
    "create:g7-acceptance-database": "tsx src/cli/create-g7-acceptance-database.ts",
    "prepare:g7-acceptance": "tsx src/cli/prepare-g7-acceptance.ts",
    "resume:g7-acceptance": "tsx src/cli/resume-g7-acceptance.ts",
    "create:g72-acceptance-database": "tsx src/cli/create-g72-acceptance-database.ts",
    "prepare:g72-acceptance": "tsx src/cli/prepare-g72-acceptance.ts",
    "resume:g72-acceptance": "tsx src/cli/resume-g72-acceptance.ts",
    "create:manual-database": "tsx src/cli/create-manual-database.ts",
    "prepare:manual-world": "tsx src/cli/prepare-manual-world.ts"
  },
  "dependencies": {
    "@avanpost/peace-v2-shared": "*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
