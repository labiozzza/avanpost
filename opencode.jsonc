{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "michael",
  "worktree": {
    "directory": "../worktrees"
  },
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "ask" },
    { "action": "shell", "resource": "npm run reset:peace:v2:*", "effect": "ask" },
    { "action": "shell", "resource": "npm run prepare:peace:v2:manual*", "effect": "ask" }
  ]
}
