# V2-only local development settings. Copy to .env.v2; never copy V1 .env values.
AVANPOST_V2_POSTGRES_USER=peace_v2
AVANPOST_V2_POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://peace_v2@127.0.0.1:5434/avanpost_v2_dev
TEST_DATABASE_URL=postgres://peace_v2@127.0.0.1:5434/avanpost_v2_test
AVANPOST_V2_COMPOSE=0
AVANPOST_V2_PORT=8788
# Optional private-LAN play: use an assigned private IPv4, never 0.0.0.0.
# AVANPOST_V2_ENABLE_LAN=true
# AVANPOST_V2_BIND_HOST=192.168.1.20
